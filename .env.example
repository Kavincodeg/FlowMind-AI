# FlowMind AI - Environment Variables
# Copy this file to .env and fill in your values

# PostgreSQL connection (matches docker-compose.yml defaults)
PGHOST=localhost
PGPORT=5432
PGDATABASE=flowmind
PGUSER=flowmind
PGPASSWORD=flowmind_dev

# Embedding model (default: all-MiniLM-L6-v2, local, no API key)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=64

# Phase 2+ - LLM (leave blank until Phase 2)
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-4-5

# Logging
LOG_LEVEL=INFO

# DEMO_MODE: set to true for local development / demonstration only.
# NEVER deploy with DEMO_MODE=true on a live system.
# When true: preset persona tokens are accepted and GET /api/users/personas returns tokens.
# When false (default): preset tokens are rejected and the personas endpoint returns 404.
DEMO_MODE=true

# CORS_ORIGINS: comma-separated list of allowed origins for the API.
# Default: localhost Vite dev server only.  Add production origin if needed.
CORS_ORIGINS=http://localhost:5173
