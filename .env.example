# FlowMind AI — Environment Variables
# Copy this file to .env and fill in your values

# PostgreSQL connection (matches docker-compose.yml defaults)
PGHOST=localhost
PGPORT=5432
PGDATABASE=flowmind
PGUSER=flowmind
PGPASSWORD=flowmind_dev

# Embedding model (default: all-MiniLM-L6-v2, local, no API key)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=64

# Phase 2+ — LLM (leave blank until Phase 2)
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-4-5

# Logging
LOG_LEVEL=INFO
